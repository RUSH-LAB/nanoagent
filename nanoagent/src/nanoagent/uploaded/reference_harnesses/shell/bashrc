# The RUSH terminal's bash (shell.py). History stays in memory.
HISTFILE=/dev/null
HISTCONTROL=
PS1='\[\e[1m\]rush\[\e[0m\]:\w\$ '
# `rush <command>`: the command as one recorded run, `rush forget <program>` and `rush help` (rush.py). `command`: python may be a
# remembered program itself.
rush() {
  command python /harness/rush.py run "$@"
}
# The member's remembered programs (.rush/agents, one per line, which the worker writes as a session starts and after each rush run
# or forget): each typed plain runs as `rush <program>`. Read again before every prompt, so every terminal follows a run in another.
RUSH_AGENTS=()
rush_agents() {
  local name kept=()
  [[ -f $RUSH_WORKSPACE/.rush/agents ]] && while IFS= read -r name; do kept+=("$name"); done < "$RUSH_WORKSPACE/.rush/agents"
  for name in "${RUSH_AGENTS[@]}"; do unset -f "$name"; done
  RUSH_AGENTS=("${kept[@]}")
  for name in "${kept[@]}"; do eval "$name() { rush $name \"\$@\"; }"; done
}
rush_agents
PROMPT_COMMAND=rush_agents
# The banner at the top of every terminal (each is a bash on this rc), and again when the member clears it: `clear` or Ctrl-L.
rush_banner() {
  printf '%s\n' 'Run nanoagent, claude, codex, pi, hermes or dsh here, and any other agent as rush <command>: it is remembered, so typed plain' \
    'from then on it is recorded too (rush forget <program> stops that). Models and tracing are set up; rush help says more.' \
    'Model provider APIs do not resolve here: point your agent at the preset $OPENAI_BASE_URL or $ANTHROPIC_BASE_URL.'
}
clear() {
  command clear "$@" && rush_banner
}
bind -x '"\C-l": clear'
rush_banner
# A resumed session's first terminal (shell.py): from when and with which agent, then what to type, or that agent's resume
# command, run at the first prompt (so it is a job of the shell, which the member is back at when it exits) and kept in history.
# A session started under an agent runs its CLI (`claude`) the same way, with nothing said.
if [ -n "$RUSH_RESUME_LINE" ]; then printf '%s\n' "$RUSH_RESUME_LINE"; fi
if [ -n "$RUSH_RESUME_TYPE" ]; then printf '%s\n' "$RUSH_RESUME_TYPE"; fi
rush_resume() {
  local run="$RUSH_RESUME_RUN"
  PROMPT_COMMAND=rush_agents
  unset RUSH_RESUME_RUN
  history -s "$run"
  eval "$run"
}
if [ -n "$RUSH_RESUME_RUN" ]; then PROMPT_COMMAND='rush_agents; rush_resume'; else unset RUSH_RESUME_RUN; fi
unset RUSH_RESUME_LINE RUSH_RESUME_TYPE
