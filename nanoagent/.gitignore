__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/
node_modules/
*.egg-info/

# A library resolves against the consumer's constraints, so this repo pins nothing; `uv run` still
# drops a lock here as a side effect of the dev venv.
uv.lock
.coverage
htmlcov/

# Provider keys. This repo is public and `git add -A` is one keystroke, so the ignore comes
# before the first key ever lands here, not after.
.env
.env.*

# Outputs
outputs/

# Fixture plugins commit their lock and their `.env`, which holds variable names only (the plugin
# loader refuses a value).
!test/plugins/*/uv.lock
!test/plugins/*/.env
