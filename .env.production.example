NODE_ENV=production
ENABLE_AUTH=true
DEV_AUTOLOGIN=false
EDITOR_PORT=3000
SITE_URL=https://mochi.example.com
CORS_ORIGIN=https://mochi.example.com

# Runtime requests use the pooled, restricted role.
DATABASE_URL=postgresql://mochi_runtime:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Migrations use the direct schema-owner connection.
DATABASE_MIGRATION_URL=postgresql://neondb_owner:REPLACE_ME@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
PG_DRIVER=neon-serverless
PG_SSL=require
PG_SSL_REJECT_UNAUTHORIZED=true

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# HTTPS transactional-email webhook for verification, reset, and invitations.
MAIL_WEBHOOK_URL=https://mail.example.com/mochi
MAIL_WEBHOOK_TOKEN=REPLACE_ME

# S3-compatible object storage. Local disk is refused in production.
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_BUCKET=mochi-assets
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
