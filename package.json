{
  "name": "rush-lab-archive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "ENABLE_AUTH=true DEV_AUTOLOGIN=true DOCUSAURUS_NO_PERSISTENT_CACHE=true node src/server/index.js & ENABLE_AUTH=true DEV_AUTOLOGIN=true docusaurus start",
    "start:site": "DOCUSAURUS_NO_PERSISTENT_CACHE=true docusaurus start",
    "build": "docusaurus build",
    "build:auth": "ENABLE_AUTH=true docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:unit": "node --test 'tests/**/*.test.mjs'",
    "test:integration": "node tests/integration/test-api.mjs",
    "test:integration:extended": "node tests/integration/test-api-extended.mjs",
    "test:integration:all": "node tests/integration/test-api.mjs && node tests/integration/test-api-extended.mjs",
    "test:server": "node src/server/index.js & sleep 2 && node tests/integration/test-api.mjs; kill %1",
    "test:all": "node --test 'tests/**/*.test.mjs' && node tests/integration/test-api.mjs && node tests/integration/test-api-extended.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "start:noauth": "DOCUSAURUS_NO_PERSISTENT_CACHE=true node src/server/index.js & docusaurus start"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.0.0",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.25",
    "mafs": "^0.21.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "drizzle-kit": "^0.31.10"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
