{
  "name": "rush-lab-archive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "DISABLE_AUTH=true DOCUSAURUS_NO_PERSISTENT_CACHE=true node server.js & docusaurus start",
    "start:auth": "DOCUSAURUS_NO_PERSISTENT_CACHE=true node server.js & docusaurus start",
    "start:site": "DISABLE_AUTH=true DOCUSAURUS_NO_PERSISTENT_CACHE=true docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:unit": "node --test 'tests/**/*.test.mjs'",
    "test:integration": "node scripts/test-api.mjs",
    "test:integration:extended": "node scripts/test-api-extended.mjs",
    "test:integration:all": "node scripts/test-api.mjs && node scripts/test-api-extended.mjs",
    "test:server": "node server.js & sleep 2 && node scripts/test-api.mjs; kill %1",
    "test:all": "node --test 'tests/**/*.test.mjs' && node scripts/test-api.mjs && node scripts/test-api-extended.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.0.0",
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.0.0",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "clsx": "^2.0.0",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.25",
    "mafs": "^0.21.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/types": "^3.10.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
