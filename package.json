{
  "name": "mochi-lab",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#plugin-api": "./src/server/plugin-api.js",
    "#markdown": "./src/utils/visitText.js"
  },
  "scripts": {
    "neon:plan": "neon config plan --config infra/neon.ts",
    "neon:deploy": "neon deploy --config infra/neon.ts",
    "new:plugin": "node scripts/dev/create-plugin.mjs",
    "db:migrate:legacy": "node --env-file-if-exists=.env.postgres.local scripts/migrations/sqlite-to-postgres.mjs",
    "db:migrate:objects": "node --env-file-if-exists=.env.postgres.local scripts/migrations/local-objects-to-postgres.mjs",
    "db:postgres:bootstrap": "node scripts/db/postgres.mjs bootstrap",
    "db:postgres:prepare": "node scripts/db/postgres.mjs prepare",
    "db:postgres:setup": "node scripts/db/postgres.mjs setup",
    "db:postgres:migrate": "node scripts/db/postgres.mjs migrate",
    "db:postgres:verify": "node scripts/db/postgres.mjs verify",
    "test:postgres": "node scripts/db/postgres.mjs test",
    "start:postgres:api": "node scripts/db/postgres.mjs serve",
    "object-storage:verify": "node --env-file-if-exists=.env.postgres.local --env-file-if-exists=.env.production.local scripts/maintenance/verify-object-storage.mjs",
    "mail:verify": "NODE_ENV=production node --env-file-if-exists=.env.production.local scripts/maintenance/verify-mail.mjs",
    "nanoagent:verify": "node scripts/maintenance/verify-nanoagent.mjs",
    "release:check": "npm test && npm run build:auth && npm run nanoagent:verify",
    "proofs:check": "cd plugins/lean-proofs/proofs && lake build",
    "proofs:test": "node --test 'tests/unit/plugins/lean-proofs/**/*.test.mjs' && npm run proofs:check",
    "docusaurus": "docusaurus",
    "start": "node scripts/dev/start-local.mjs --postgres",
    "start:postgres": "node scripts/dev/start-local.mjs --postgres",
    "start:site": "ENABLE_AUTH=true DEV_AUTOLOGIN=false docusaurus start --no-open",
    "start:production": "NODE_ENV=production ENABLE_AUTH=true node src/server/index.js",
    "build": "docusaurus build",
    "build:auth": "ENABLE_AUTH=true docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:unit": "node --test 'tests/**/*.test.mjs'",
    "test:integration": "node tests/integration/test-api.mjs",
    "test:integration:extended": "node tests/integration/test-api-extended.mjs",
    "test:integration:all": "node tests/integration/test-api.mjs && node tests/integration/test-api-extended.mjs && node tests/integration/test-new-features.mjs && node tests/integration/test-remaining.mjs && node tests/integration/test-workflows.mjs && node tests/integration/test-resilience.mjs",
    "test:server": "node src/server/index.js & sleep 2 && node tests/integration/test-api.mjs; kill %1",
    "test:all": "npm test && npm run test:integration:all",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "start:noauth": "node scripts/dev/start-local.mjs --no-auth"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.0.0",
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "@neondatabase/serverless": "^1.1.0",
    "@uiw/react-codemirror": "^4.25.11",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.0.0",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.25",
    "kysely": "^0.29.5",
    "mafs": "^0.21.0",
    "pg": "^8.23.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@electric-sql/pglite": "^0.5.8"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
