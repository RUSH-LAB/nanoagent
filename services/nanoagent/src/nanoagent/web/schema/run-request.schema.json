{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoagent.dev/schema/run-request-v1.json",
  "title": "RunRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "input": {"type": "string", "minLength": 1, "maxLength": 100000},
    "profile": {"type": "string", "minLength": 1, "maxLength": 100},
    "instructions": {"type": "string", "maxLength": 20000},
    "messages": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/Message"}
    },
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "required": ["input"],
  "$defs": {
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["user", "assistant", "tool"]},
        "content": {"type": "string", "maxLength": 100000},
        "tool_call_id": {"type": "string", "minLength": 1}
      },
      "required": ["role", "content"],
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "tool"}}, "required": ["role"]},
          "then": {"required": ["tool_call_id"]},
          "else": {"not": {"required": ["tool_call_id"]}}
        }
      ]
    }
  }
}
