{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanoagent.dev/schema/run-events-v1.json",
  "title": "RunEvent",
  "oneOf": [
    {"$ref": "#/$defs/StartEvent"},
    {"$ref": "#/$defs/DeltaEvent"},
    {"$ref": "#/$defs/ToolEvent"},
    {"$ref": "#/$defs/StepEvent"},
    {"$ref": "#/$defs/DoneEvent"},
    {"$ref": "#/$defs/ErrorEvent"}
  ],
  "$defs": {
    "EventBase": {
      "type": "object",
      "properties": {"runId": {"type": "string"}},
      "required": ["runId"]
    },
    "Usage": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "ModelCallMetrics": {
      "type": "object",
      "properties": {
        "kind": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 0},
        "ttft_s": {"type": ["number", "null"], "minimum": 0},
        "generation_s": {"type": ["number", "null"], "minimum": 0},
        "output_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
        "usage": {"$ref": "#/$defs/Usage"},
        "cost": {"type": "number", "minimum": 0},
        "error": {"type": ["string", "null"]}
      },
      "required": ["kind", "duration_s", "ttft_s", "generation_s", "output_tokens_per_second", "usage", "cost", "error"]
    },
    "ToolCallMetrics": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 0},
        "is_error": {"type": "boolean"},
        "error": {"type": ["string", "null"]}
      },
      "required": ["id", "name", "duration_s", "is_error", "error"]
    },
    "StepMetrics": {
      "type": "object",
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "duration_s": {"type": "number", "minimum": 0},
        "model_s": {"type": "number", "minimum": 0},
        "tools_s": {"type": "number", "minimum": 0},
        "overhead_s": {"type": "number", "minimum": 0},
        "usage": {"$ref": "#/$defs/Usage"},
        "cost": {"type": "number", "minimum": 0},
        "model_calls": {"type": "array", "items": {"$ref": "#/$defs/ModelCallMetrics"}},
        "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/ToolCallMetrics"}}
      },
      "required": ["step", "duration_s", "model_s", "tools_s", "overhead_s", "usage", "cost", "model_calls", "tool_calls"]
    },
    "RunMetrics": {
      "type": "object",
      "properties": {
        "duration_s": {"type": "number", "minimum": 0},
        "model_s": {"type": "number", "minimum": 0},
        "tools_s": {"type": "number", "minimum": 0},
        "overhead_s": {"type": "number", "minimum": 0},
        "usage": {"$ref": "#/$defs/Usage"},
        "cost": {"type": "number", "minimum": 0},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/StepMetrics"}}
      },
      "required": ["duration_s", "model_s", "tools_s", "overhead_s", "usage", "cost", "steps"]
    },
    "StartEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "start"},
            "metadata": {"type": ["object", "null"], "additionalProperties": true},
            "profile": {"type": "string"},
            "harness": {"type": "string"},
            "model": {"type": "string"}
          },
          "required": ["type", "metadata", "profile", "harness", "model"]
        }
      ]
    },
    "DeltaEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "delta"},
            "kind": {"enum": ["content", "reasoning"]},
            "text": {"type": "string"}
          },
          "required": ["type", "kind", "text"]
        }
      ]
    },
    "ToolEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "tool"},
            "id": {"type": "string"},
            "name": {"type": "string"},
            "arguments": {},
            "output": {"type": "string"},
            "is_error": {"type": "boolean"}
          },
          "required": ["type", "id", "name", "arguments", "output", "is_error"]
        }
      ]
    },
    "StepEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "step"},
            "step": {"type": "integer", "minimum": 0},
            "usage": {"$ref": "#/$defs/Usage"},
            "cost": {"type": "number", "minimum": 0},
            "metrics": {"anyOf": [{"$ref": "#/$defs/StepMetrics"}, {"type": "null"}]}
          },
          "required": ["type", "step", "usage", "cost"]
        }
      ]
    },
    "DoneEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "done"},
            "answer": {"type": "string"},
            "stop_reason": {"type": "string"},
            "steps": {"type": "integer", "minimum": 0},
            "usage": {"$ref": "#/$defs/Usage"},
            "cost": {"type": "number", "minimum": 0},
            "metrics": {"anyOf": [{"$ref": "#/$defs/RunMetrics"}, {"type": "null"}]},
            "error": {"type": ["string", "null"]},
            "profile": {"type": "string"},
            "harness": {"type": "string"},
            "model": {"type": "string"}
          },
          "required": ["type", "answer", "stop_reason", "steps", "usage", "cost", "error", "profile", "harness", "model"]
        }
      ]
    },
    "ErrorEvent": {
      "allOf": [
        {"$ref": "#/$defs/EventBase"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "error"},
            "code": {"type": "string"},
            "error": {"type": "string"}
          },
          "required": ["type", "code", "error"]
        }
      ]
    }
  }
}
