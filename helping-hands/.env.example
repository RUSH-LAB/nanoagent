# Copy to .env and fill in the values. Never commit .env.

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Postgres (`npm run db:postgres:setup` writes these, see scripts/README.md).
DATABASE_MIGRATION_URL=
DATABASE_URL=
PG_SSL=require
PG_SSL_REJECT_UNAUTHORIZED=true

ENABLE_AUTH=true
DEV_AUTOLOGIN=false
BETTER_AUTH_SECRET=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

RESEND_API_KEY=
MAIL_FROM=
MAIL_TEST_TO=

ROOT_EMAIL=
ROOT_NAME=Root
ROOT_PASSWORD=

# Serve content from the workspace file system (docs/plans/workspace-filesystem.md).
CONTENT_STORE=fs
