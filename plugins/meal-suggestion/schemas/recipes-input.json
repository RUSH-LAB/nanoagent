{
  "type": "object",
  "required": [
    "recipes",
    "meal",
    "preference"
  ],
  "properties": {
    "recipes": {
      "type": "string",
      "minLength": 1,
      "description": "The recipes file in the workspace (inputs/recipes.json): each recipe's meals, tags and grams of each ingredient per serving"
    },
    "meal": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner"
      ]
    },
    "preference": {
      "type": "object",
      "required": [
        "require",
        "exclude"
      ],
      "properties": {
        "require": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags every dish must have, e.g. vegetarian"
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags no dish may have, e.g. dairy"
        }
      },
      "additionalProperties": false,
      "description": "The food preference, a hard filter on recipe tags"
    }
  },
  "additionalProperties": false
}
