{
  "type": "object",
  "required": [
    "ingredients",
    "recipes",
    "meal",
    "constraints",
    "preference",
    "objective",
    "max_servings"
  ],
  "properties": {
    "ingredients": {
      "type": "string",
      "minLength": 1,
      "description": "The ingredients file in the workspace (inputs/ingredients.json): each ingredient's kcal and grams of protein, fat, carbs and fiber per 100 g"
    },
    "recipes": {
      "type": "string",
      "minLength": 1,
      "description": "The recipes file in the workspace (inputs/recipes.json): each recipe's meals, tags and grams of each ingredient per serving"
    },
    "meal": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner"
      ],
      "description": "The meal to suggest"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "kcal": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "protein": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "fat": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "carbs": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "fiber": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Bounds on the meal's totals, e.g. {\"protein\": {\"min\": 50}, \"kcal\": {\"max\": 1000}}: kcal, and grams of protein, fat, carbs and fiber"
    },
    "preference": {
      "type": "object",
      "required": [
        "require",
        "exclude"
      ],
      "properties": {
        "require": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags every dish must have, e.g. vegetarian"
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags no dish may have, e.g. dairy"
        }
      },
      "additionalProperties": false,
      "description": "The food preference, a hard filter on recipe tags"
    },
    "objective": {
      "type": "object",
      "required": [
        "sense",
        "nutrient"
      ],
      "properties": {
        "sense": {
          "type": "string",
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "nutrient": {
          "type": "string",
          "enum": [
            "kcal",
            "protein",
            "fat",
            "carbs",
            "fiber"
          ]
        }
      },
      "additionalProperties": false,
      "description": "The one total to optimize, e.g. {\"sense\": \"maximize\", \"nutrient\": \"protein\"}"
    },
    "max_servings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "The most whole servings of any one recipe"
    }
  },
  "additionalProperties": false
}
