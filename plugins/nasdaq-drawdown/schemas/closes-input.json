{
  "type": "object",
  "required": [
    "tickers",
    "date"
  ],
  "properties": {
    "tickers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$",
        "description": "A ticker symbol as Nasdaq lists it, e.g. AAPL"
      },
      "description": "Up to 25 distinct tickers"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A past trading session, YYYY-MM-DD"
    }
  },
  "additionalProperties": false
}
