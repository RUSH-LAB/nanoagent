{
  "type": "object",
  "required": [
    "arxiv_id",
    "date"
  ],
  "properties": {
    "arxiv_id": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{5}(v\\d+)?$",
      "description": "YYMM.NNNNN, optionally with a version"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A UTC date, YYYY-MM-DD"
    }
  },
  "additionalProperties": false
}
