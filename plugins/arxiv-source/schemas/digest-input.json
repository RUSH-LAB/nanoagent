{
  "type": "object",
  "required": [
    "date",
    "entries"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A UTC date, YYYY-MM-DD"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arxiv_id",
          "title",
          "authors",
          "summary",
          "link"
        ],
        "properties": {
          "arxiv_id": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{5}$",
            "description": "An arXiv id of the form YYMM.NNNNN"
          },
          "title": {
            "type": "string",
            "description": "Exactly as arXiv lists it"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exactly as arXiv lists them, in order"
          },
          "summary": {
            "type": "string",
            "description": "Exactly two lines, separated by one newline"
          },
          "link": {
            "type": "string",
            "description": "https://arxiv.org/abs/<arxiv_id>"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
