{
  "type": "object",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "fen": {
      "type": "string"
    },
    "nodes": {
      "type": "integer",
      "description": "Stockfish's search per move, in nodes, on one thread"
    },
    "best": {
      "type": "string",
      "description": "The legal move with the highest win probability for the mover"
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "move",
          "position",
          "win_prob"
        ],
        "properties": {
          "move": {
            "type": "string",
            "pattern": "^[a-h][1-8][a-h][1-8][nbrq]?$",
            "description": "A legal move, in UCI"
          },
          "position": {
            "type": "string",
            "description": "The FEN after the move"
          },
          "win_prob": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The mover's win probability after the move"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
