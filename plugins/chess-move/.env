# Environment variables this plugin needs, one NAME per line and never a value.
# NanoAgent passes each one through from its own environment; run.sh checks they are set.
# A mind-sports-arena checkout: the chess app, its board page and its board drawing.
MSA_ROOT
# Where that checkout's sandbox.sh built its engines, which is where Stockfish is found.
LOCALDB
# The browser the board is screenshotted out of (msa.cdp.Headless).
CHROME_BIN
