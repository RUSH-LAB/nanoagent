# Local NanoAgent
OPENROUTER_API_KEY=replace-me

# Neon PostgreSQL; `npm run db:postgres:setup` prepares these values.
DATABASE_MIGRATION_URL=postgresql://schema-owner:replace-me@host/database
DATABASE_URL=postgresql://mochi_runtime:replace-me@host/database
PG_DRIVER=pg
PG_SSL=require
PG_SSL_REJECT_UNAUTHORIZED=true
ENABLE_AUTH=true
DEV_AUTOLOGIN=false
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Optional deployment verification
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
RESEND_API_KEY=
MAIL_FROM=
MAIL_TEST_TO=

# Explicit root-account provisioning
ROOT_EMAIL=root@mochi.local
ROOT_NAME=Mochi Root
ROOT_PASSWORD=replace-with-a-unique-password
