# Copy to .env and fill in the values. Never commit .env.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
# An OpenRouter management key, required: each member's RUSH Lab is given an OpenRouter
# key of its own on this account, $10 for every member together (src/server/openrouter-keys.js);
# npm start's in a workspace of its own. npm run db:setup sets production's.
OPENROUTER_MANAGEMENT_KEY=

# No database URL: npm start runs on the local database (npm run db:setup, see
# docs/infra/neon-postgres-setup.md), and refuses one here.

BETTER_AUTH_SECRET=

# What a release sends as `Authorization: Bearer` to upload Mochi Lab's bundles
# (src/server/routes/lab.js); unset, uploads are refused.
LAB_UPLOAD_TOKEN=

# GitHub is the only sign-in (see scripts/README.md). ROOT_GITHUB_LOGIN is the
# GitHub account that administers the platform.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ROOT_GITHUB_LOGIN=

RESEND_API_KEY=
MAIL_FROM=
MAIL_TEST_TO=
