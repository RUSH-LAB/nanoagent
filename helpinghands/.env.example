# Copy to .env and fill in the values. Never commit .env.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
# An OpenRouter management key: each member's Mochi Lab is given an OpenRouter key
# of its own on this account, $10 for every member together (src/server/openrouter-keys.js).
OPENROUTER_MANAGEMENT_KEY=

# Production's database as the runtime role (`npm run db:setup` writes these from
# Railway, see scripts/README.md). Never set DATABASE_MIGRATION_URL here.
DATABASE_URL=
PG_SSL=require
PG_SSL_REJECT_UNAUTHORIZED=true

BETTER_AUTH_SECRET=

# What a release sends as `Authorization: Bearer` to upload Mochi Lab's bundles
# (src/server/routes/lab.js); unset, uploads are refused.
LAB_UPLOAD_TOKEN=

# GitHub is the only sign-in (see scripts/README.md). ROOT_GITHUB_LOGIN is the
# GitHub account that administers the platform.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ROOT_GITHUB_LOGIN=

RESEND_API_KEY=
MAIL_FROM=
MAIL_TEST_TO=
