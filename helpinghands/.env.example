# Copy to .env and fill in the values. Never commit .env.

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Postgres (`npm run db:postgres:setup` writes these, see scripts/README.md).
DATABASE_MIGRATION_URL=
DATABASE_URL=
PG_SSL=require
PG_SSL_REJECT_UNAUTHORIZED=true

BETTER_AUTH_SECRET=

# GitHub is the only sign-in (see scripts/README.md). ROOT_GITHUB_LOGIN is the
# GitHub account that administers the platform.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ROOT_GITHUB_LOGIN=

RESEND_API_KEY=
MAIL_FROM=
MAIL_TEST_TO=
