{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "terminal",
  "description": "The terminal windows' own page (src/terminal.rs) reaches the terminal's commands; no remote page reaches any.",
  "windows": ["terminal-*"],
  "permissions": [
    "allow-terminal-projects",
    "allow-terminal-new-project",
    "allow-terminal-open-project",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-resize"
  ]
}
