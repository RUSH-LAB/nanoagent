{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RUSH Lab",
  "version": "0.0.0",
  "identifier": "lab.mochi.lab",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/stage.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/node",
      "binaries/uv"
    ],
    "resources": {
      "resources/runner/": "runner/",
      "resources/terminal/": "terminal/",
      "resources/nanoagent/": "nanoagent/",
      "resources/config.json": "config.json",
      "resources/stamp": "stamp"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {"installMode": "currentUser"}
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "windows": {"installMode": "quiet"},
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MTAyMjQ0MDQ3OEVFNTgKUldSWTduZ0VSQ0lRdC85YmpKTGppU1g4ZTZ6VkorbTlJNVlKejdQQ25WZUFVQ0I3Z1VGMXZFTnkK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "rushlab"
        ]
      }
    }
  }
}
