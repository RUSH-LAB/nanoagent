{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RUSH Lab",
  "version": "0.0.0",
  "identifier": "lab.mochi.lab",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "node scripts/stage.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/node",
      "binaries/uv"
    ],
    "resources": {
      "resources/runner/": "runner/",
      "resources/nanoagent/": "nanoagent/",
      "resources/config.json": "config.json",
      "resources/stamp": "stamp"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "rushlab"
        ]
      }
    }
  }
}
