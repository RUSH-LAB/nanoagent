{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH uploaded harness v1",
  "$defs": {
    "Id": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9]", "not": {"pattern": "[^A-Za-z0-9._:-]"}
    },
    "Sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "Protocol": {"const": "rush.harness.v1"},
    "HarnessName": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "HarnessVersion": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
    "Dialects": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["chat_completions", "responses", "anthropic_messages"]}
    },
    "Argv": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "prefixItems": [{"type": "string", "minLength": 1, "maxLength": 4096}],
      "items": {"type": "string", "maxLength": 4096}
    },
    "Paths": {
      "type": "array", "uniqueItems": true, "maxItems": 1024,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "Manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "name", "version", "dialects", "toolchain", "lockfiles", "build", "run"],
      "properties": {
        "protocol": {"$ref": "#/$defs/Protocol"},
        "name": {"$ref": "#/$defs/HarnessName"},
        "version": {"$ref": "#/$defs/HarnessVersion"},
        "dialects": {"$ref": "#/$defs/Dialects"},
        "toolchain": {"$ref": "#/$defs/Id"},
        "lockfiles": {"$ref": "#/$defs/Paths"},
        "build": {
          "type": "object", "additionalProperties": false,
          "required": ["argv", "outputs"],
          "properties": {
            "argv": {"$ref": "#/$defs/Argv"},
            "outputs": {"$ref": "#/$defs/Paths", "minItems": 1}
          }
        },
        "run": {
          "type": "object", "additionalProperties": false,
          "required": ["argv"],
          "properties": {"argv": {"$ref": "#/$defs/Argv"}}
        }
      }
    },
    "Task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "description", "plugin_name"],
      "properties": {
        "id": {"$ref": "#/$defs/Id"},
        "kind": {"enum": ["agent", "decide", "tool"]},
        "description": {"type": "string"},
        "plugin_name": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "Case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id"],
      "properties": {
        "case_id": {"$ref": "#/$defs/Id"}
      }
    },
    "Prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "user", "sha256"],
      "properties": {
        "system": {"type": ["string", "null"], "maxLength": 1000000},
        "user": {"type": ["string", "null"], "maxLength": 1000000},
        "sha256": {"$ref": "#/$defs/Sha256"}
      },
      "anyOf": [{"properties": {"system": {"type": "string", "minLength": 1}}}, {"properties": {"user": {"type": "string", "minLength": 1}}}]
    },
    "OpenRouter": {
      "type": "object", "additionalProperties": false,
      "required": ["base_url", "model", "dialects"],
      "properties": {
        "base_url": {"type": "string", "format": "uri", "pattern": "^https?://.+/api/v1$"},
        "model": {"type": "string", "minLength": 3, "maxLength": 200},
        "dialects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["chat_completions", "responses", "anthropic_messages"]}
        }
      }
    },
    "Tools": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "available"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "available": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "description", "input_schema", "output_schema"],
            "properties": {
              "name": {"$ref": "#/$defs/Id"},
              "description": {"type": "string", "minLength": 1},
              "input_schema": {"type": "object"},
              "output_schema": {"type": "object"}
            }
          }
        }
      }
    },
    "ToolCall": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": {
        "name": {"$ref": "#/$defs/Id"},
        "arguments": {"type": "object"},
        "cause": {
          "type": "object", "additionalProperties": false,
          "required": ["model_call_id", "tool_call_id"],
          "properties": {
            "model_call_id": {"$ref": "#/$defs/Id"},
            "tool_call_id": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    },
    "ToolResult": {
      "type": "object", "unevaluatedProperties": false,
      "oneOf": [
        {"properties": {"output": {"type": "object"}}, "required": ["output"]},
        {
          "properties": {
            "error": {
              "type": "object", "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {"code": {"$ref": "#/$defs/Id"}, "message": {"type": "string", "minLength": 1}}
            }
          },
          "required": ["error"]
        }
      ]
    },
    "ExecCall": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd", "timeout_ms"],
      "properties": {
        "argv": {"$ref": "#/$defs/Argv"},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 1024},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    },
    "ExecStream": {
      "type": "object", "additionalProperties": false,
      "required": ["base64", "truncated"],
      "properties": {
        "base64": {"type": "string", "contentEncoding": "base64"},
        "truncated": {"type": "boolean"}
      }
    },
    "ExecResult": {
      "type": "object", "additionalProperties": false,
      "required": ["termination", "stdout", "stderr"],
      "properties": {
        "termination": {
          "type": "object", "required": ["status"],
          "oneOf": [
            {
              "properties": {"status": {"const": "exited"}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}},
              "required": ["exit_code"]
            },
            {
              "properties": {"status": {"const": "signaled"}, "signal": {"type": "integer", "minimum": 1}},
              "required": ["signal"]
            },
            {"properties": {"status": {"const": "timed_out"}}}
          ],
          "unevaluatedProperties": false
        },
        "stdout": {"$ref": "#/$defs/ExecStream"},
        "stderr": {"$ref": "#/$defs/ExecStream"}
      }
    },
    "Limits": {
      "type": "object", "additionalProperties": false,
      "required": [
        "wall_time_ms", "max_model_calls", "max_output_tokens_per_call", "max_cost_usd", "internet_access",
        "cpus", "memory_mb", "pids", "workspace_bytes", "workspace_files", "tmp_bytes",
        "build_wall_ms", "build_memory_mb", "build_output_bytes", "build_files", "build_tmp_bytes"
      ],
      "properties": {
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "max_model_calls": {"type": "integer", "minimum": 1},
        "max_output_tokens_per_call": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "internet_access": {"type": "boolean"},
        "cpus": {"type": "number", "exclusiveMinimum": 0},
        "memory_mb": {"type": "integer", "minimum": 1},
        "pids": {"type": "integer", "minimum": 1},
        "workspace_bytes": {"type": "integer", "minimum": 1},
        "workspace_files": {"type": "integer", "minimum": 1},
        "tmp_bytes": {"type": "integer", "minimum": 1},
        "build_wall_ms": {"type": "integer", "minimum": 1},
        "build_memory_mb": {"type": "integer", "minimum": 1},
        "build_output_bytes": {"type": "integer", "minimum": 1},
        "build_files": {"type": "integer", "minimum": 1},
        "build_tmp_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "attempt_id", "task", "free_form", "case", "prompt", "harness", "workspace", "openrouter", "tools", "exec_url", "events_url", "limits", "interactive"],
      "properties": {
        "protocol": {"$ref": "#/$defs/Protocol"},
        "attempt_id": {"type": "string", "format": "uuid"},
        "task": {"oneOf": [{"$ref": "#/$defs/Task"}, {"type": "null"}]},
        "free_form": {"type": "boolean", "description": "Whether the session has no case: only the Terminal's with a person at it, who runs any agent and prompts it themselves. It is the same empty shell whichever plugin's page opened it, so task, case and prompt are null, nothing is written for a task, and nothing scores the session; its model calls and commands are recorded."},
        "case": {"oneOf": [{"$ref": "#/$defs/Case"}, {"type": "null"}]},
        "prompt": {"oneOf": [{"$ref": "#/$defs/Prompt"}, {"type": "null"}]},
        "harness": {"type": ["string", "null"], "description": "The agent the case runs: a CLI of the shell harness (claude, codex, pi, dsh, hermes, nanoagent) or a member's own `rush <command>`, started with the case's prompt as its last argument (harnesses.yaml); null for a free-form session."},
        "workspace": {"const": "/rush/workspace"},
        "openrouter": {"$ref": "#/$defs/OpenRouter"},
        "tools": {"$ref": "#/$defs/Tools"},
        "exec_url": {"type": "string", "format": "uri"},
        "events_url": {"type": "string", "format": "uri"},
        "limits": {"$ref": "#/$defs/Limits"},
        "interactive": {"type": "boolean", "description": "Whether a person is at the harness's terminal (a plugin page's Harness tab session), who types at it and ends it: the harness then runs its CLI interactively. In a free-form session they open more terminals in the same VM, each running run.argv again with RUSH_TERMINAL its id (the harness's is 0), and the session ends with the last."}
      },
      "if": {"properties": {"free_form": {"const": true}}},
      "then": {"properties": {"task": {"type": "null"}, "case": {"type": "null"}, "prompt": {"type": "null"}, "harness": {"type": "null"}}},
      "else": {"properties": {"task": {"type": "object"}, "case": {"type": "object"}, "prompt": {"type": "object"}, "harness": {"type": "string"}}}
    },
    "HarnessEvent": {
      "type": "object",
      "properties": {
        "protocol": {"$ref": "#/$defs/Protocol"},
        "emitter_id": {"$ref": "#/$defs/Id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "elapsed_us": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "span_id": {"$ref": "#/$defs/Id"},
        "data": {"type": "object"}
      },
      "required": ["protocol", "event", "emitter_id", "sequence", "span_id"],
      "oneOf": [
        {
          "properties": {
            "event": {"const": "span.start"},
            "parent_span_id": {"$ref": "#/$defs/Id"},
            "kind": {"enum": ["agent", "subagent", "decision", "tool", "memory", "operation"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "required": ["kind", "name"]
        },
        {
          "properties": {
            "event": {"const": "span.end"},
            "status": {"enum": ["ok", "error", "canceled"]}
          },
          "required": ["status"]
        },
        {
          "properties": {"event": {"const": "log"}, "message": {"type": "string", "maxLength": 65536}},
          "required": ["message"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
