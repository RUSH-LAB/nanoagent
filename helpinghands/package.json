{
  "name": "mochi-lab",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "mochi": "./cli/mochi.mjs"
  },
  "imports": {
    "#plugin-api": "./src/server/plugin-api.js",
    "#markdown": "./src/utils/visitText.js"
  },
  "scripts": {
    "neon:plan": "neon config plan --config infra/neon.ts",
    "neon:deploy": "neon deploy --config infra/neon.ts",
    "db:sync": "neon branches reset development --parent",
    "new:plugin": "node scripts/dev/create-plugin.mjs",
    "db:postgres:bootstrap": "node scripts/db/postgres.mjs bootstrap",
    "db:postgres:prepare": "node scripts/db/postgres.mjs prepare",
    "db:postgres:setup": "node scripts/db/postgres.mjs setup",
    "db:postgres:migrate": "node scripts/db/postgres.mjs migrate",
    "db:postgres:verify": "node scripts/db/postgres.mjs verify",
    "fs:import": "node --env-file-if-exists=.env scripts/db/import-fs.mjs",
    "test:postgres": "node scripts/db/postgres.mjs test",
    "start:postgres:api": "node scripts/db/postgres.mjs serve",
    "object-storage:verify": "node --env-file-if-exists=.env scripts/maintenance/verify-object-storage.mjs",
    "mail:verify": "NODE_ENV=production node --env-file-if-exists=.env scripts/maintenance/verify-mail.mjs",
    "nanoagent:verify": "node scripts/maintenance/verify-nanoagent.mjs",
    "release:check": "npm test && npm run build && npm run nanoagent:verify",
    "proofs:check": "cd plugins/lean-proofs/proofs && lake build",
    "proofs:test": "node --test 'tests/unit/plugins/lean-proofs/**/*.test.mjs' && npm run proofs:check",
    "docusaurus": "docusaurus",
    "start": "node scripts/dev/start-local.mjs",
    "desktop": "npm --prefix desktop install --no-audit --no-fund && npm --prefix desktop run build && open \"desktop/src-tauri/target/release/bundle/macos/Mochi Lab.app\"",
    "start:site": "docusaurus start --no-open",
    "start:production": "NODE_ENV=production node src/server/index.js",
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "test": "node --test 'tests/**/*.test.mjs'",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.0.0",
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "@uiw/react-codemirror": "^4.25.11",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.25",
    "kysely": "^0.29.5",
    "mafs": "^0.21.0",
    "pg": "^8.23.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.21.3",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@electric-sql/pglite": "^0.5.8",
    "neon": "^8.3.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
